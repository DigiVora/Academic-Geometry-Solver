        <Component class="javax.swing.JLabel" name="jLabel1">
          <Properties>
            <Property name="text" type="java.lang.String" value="&lt;html&gt; Aplikasi ini dirancang untuk mempermudah perhitungan&lt;br&gt; luas dan keliling bangun datar secara akurat dan cepat.&lt;br&gt;  Aplikasi ini mendukung perhitungan untuk Lingkaran,&lt;br&gt; Persegi Panjang, dan Segitiga.&lt;br&gt; Dikembangkan untuk memenuhi kebutuhan alat bantu&lt;br&gt; praktis dalam pembelajaran matematika. &lt;/html&gt;"/>
          </Properties>
        </Component>
      </SubComponents>
